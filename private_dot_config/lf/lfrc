# compress current file or selected files with tar and gunzip
cmd tar ${{
    set -f
    mkdir $1
    cp -r $fx $1
    tar czf $1.tar.gz $1
    rm -rf $1
}}

# compress current file or selected files with zip
cmd zip ${{
    set -f
    mkdir $1
    cp -r $fx $1
    zip -r $1.zip $1
    rm -rf $1
}}

cmd cpy ${{
    if [ -z "$fs" ]; then
        printf "%s" "$(basename $f)" | xclip -selection clipboard 2> /dev/null && exit 0
        printf "%s" "$(basename $f)" | wl-copy 2> /dev/null && exit 0
    else
        printf "%s\n" "$(basename $fs)" | xclip -selection clipboard 2> /dev/null && exit 0
        printf "%s\n" "$(basename $fs)" | wl-copy 2> /dev/null && exit 0
    fi
    exit 1
}}

# Bindings
map n down
map e up
map i open
map I dragon-drag
map U dragon-drag-target
map N push nnnnn
map E push eeeee
map , search-next
map . search-prev
map D delete
map B extract
map <c-n> push :mkdir<space>
map <c-r> reload
map <enter> shell
map x $$f
map X !$f
map o $mimeopen $f
map O $mimeopen --ask $f
map C clear

map V bulkrename

map j metadata_show
map J metadata_clean

map A rename # at the very end
map c push A<c-u> # new rename
map K push A<c-a> # at the very beginning
map k push A<a-b><a-b><a-f> # before extention
map a push A<a-b> # after extention

map gf cd /.files
map gc cd ~/.config
map gS cd ~/.src
map gm cd ~/Videos/Movies
map gs cd ~/Videos/Shows
map gM cd /run/media
#map W $setsid -f $TERMINAL >/dev/null 2>&1

map Y cpy

