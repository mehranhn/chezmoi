include "config-device.kdl"
// https://yalter.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {
            model "pc104"
            layout "us,ir,us"
            variant "colemak,,"
            options "caps:backspace,grp:alt_shift_toggle"
        }

        repeat-delay 300
        repeat-rate 25
        track-layout "window"
        // Enable numlock on startup, omitting this setting disables it.
        // numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    disable-power-key-handling
    // warp-mouse-to-focus mode="center-xy"

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="40%"
}

// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    gaps 9

    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"

    // You can customize the widths that "switch-preset-column-width" (Mod+T) toggles between.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can also customize the heights that "switch-preset-window-height" (Mod+Shift+R) toggles between.
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // You can change the default width of the new windows.
    default-column-width { proportion 0.5; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}

    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.

    focus-ring {
        // off

        width 1
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        off

        width 1
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // You can enable drop shadows for windows.
    shadow {
        // Uncomment the next line to enable shadows.
        // on

        // By default, the shadow draws only around its window, and not behind it.
        // Uncomment this setting to make the shadow draw behind its window.
        //
        // Note that niri has no way of knowing about the CSD window corner
        // radius. It has to assume that windows have square corners, leading to
        // shadow artifacts inside the CSD rounded corners. This setting fixes
        // those artifacts.
        //
        // However, instead you may want to set prefer-no-csd and/or
        // geometry-corner-radius. Then, niri will know the corner radius and
        // draw the shadow correctly, without having to draw it behind the
        // window. These will also remove client-side shadows if the window
        // draws any.
        //
        // draw-behind-window true

        // You can change how shadows look. The values below are in logical
        // pixels and match the CSS box-shadow properties.

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// spawn-at-startup "mpd"
spawn-at-startup "/usr/lib/xdg-desktop-portal" "-r"
spawn-at-startup "hyprpaper"
spawn-sh-at-startup "swayidle -C ~/.config/swayidle/config-niri"
spawn-at-startup "hyprsunset"
spawn-at-startup "gammastep-indicator" "-r" "-l" "35.73001482117079:51.307652033138496"
// spawn-sh-at-startup "dunst ~/.config/dunst/dunstrc"
spawn-at-startup "udiskie"
spawn-at-startup "foot" "--server"
spawn-at-startup "wl-paste" "--watch" "clipvault" "store"
spawn-at-startup "/usr/lib/hyprpolkitagent/hyprpolkitagent"
spawn-at-startup "easyeffects" "--gapplication-service"
// spawn-at-startup "nm-applet"
spawn-at-startup "blueman-applet"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

// Uncomment this line to ask the clients to omit their client-side decorations if possible.
// If the client will specifically ask for CSD, the request will be honored.
// Additionally, clients will be informed that they are tiled, removing some client-side rounded corners.
// This option will also fix border/focus ring drawing behind some semitransparent windows.
// After enabling or disabling this, you need to restart the apps for this to take effect.
prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S_niri.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
// The wiki explains how to configure individual animations:
// https://yalter.github.io/niri/Configuration:-Animations
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0

    workspace-switch {
        off
    }
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

layer-rule {
    match namespace="notifications"

    block-out-from "screencast"
}

window-rule {
    open-maximized false
    open-maximized-to-edges false
}

window-rule {
    match app-id="Myazi"
    match app-id="Mnvim"
    match app-id="zen"
    match app-id="org.qbittorrent.qBittorrent" title="^qBittorrent.*"
    match app-id="com.obsproject.Studio"

    open-maximized-to-edges true
}

window-rule {
    match app-id="org.jellyfin.JellyfinDesktop"

    open-fullscreen true
}

window-rule {
    match app-id="info.mumble.Mumble"

    default-column-width { proportion 0.50; }
}

window-rule {
    match app-id="zen" title="^Picture-in-Picture$"

    open-floating true
    default-floating-position x=275 y=25 relative-to="bottom-right"
    max-height 400
}

window-rule {
    match app-id="org.telegram.desktop"
    exclude app-id="org.telegram.desktop" title="Media viewer"

    default-column-width { proportion 0.48; }
}

window-rule {
    match app-id="org.telegram.desktop" title="Media viewer"

    open-floating true
    draw-border-with-background false
}

window-rule {
    match app-id="org.gajim.Gajim"

    default-column-width { proportion 0.52; }
}

window-rule {
    match app-id="Mbtop"
    match app-id="Mncmpcpp"
    match app-id="com.github.wwmm.easyeffects"

    open-floating true
    default-column-width { proportion 0.95; }
    default-window-height { proportion 0.90; }
}

window-rule {
    match app-id="org.pulseaudio.pavucontrol"

    open-floating true
    default-column-width { fixed 500; }
    default-window-height { fixed 600; }
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id="Mmixer"

    open-floating true
    default-column-width { fixed 500; }
    default-window-height { fixed 600; }
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match app-id="footclient"
    match app-id="Mnvim"
    match app-id="Mbtop"
    match app-id="Myazi"
    match app-id="Mncmpcpp"
    match app-id="Mmixer"

    background-effect {
        blur true
        xray true
    }
}

binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name
    // in the end. To find an XKB name for a particular key, you may use a program
    // like wev.
    //
    // "Mod" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.
    //
    // Most actions that you can bind here can also be invoked programmatically with
    // `niri msg action do-something`.

    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Q repeat=false hotkey-overlay-title="Open a Terminal: foot" { spawn "footclient"; }
    Alt+Space repeat=false hotkey-overlay-title="Run an Application: tofi" { spawn "tofi-drun" "--drun-launch" "true"; }

    // sound and microphone
    Alt+F1 hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    Alt+F2 hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    Alt+F3 hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    Super+F1 hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Super+F2 hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SOURCE@" "5%-"; }
    Super+F3 hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SOURCE@" "5%+"; }

    XF86AudioRaiseVolume hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Super+XF86AudioMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Super+XF86AudioRaiseVolume hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SOURCE@" "5%+"; }
    Super+XF86AudioLowerVolume hotkey-overlay-title=null allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SOURCE@" "5%-"; }

    // sound and microphone ashell
    // Alt+F1 hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "ashell" "msg" "volume-toggle-mute"; }
    // Alt+F2 hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "volume-down"; }
    // Alt+F3 hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "volume-up"; }
    // Super+F1 hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "ashell" "msg" "microphone-toggle-mute"; }
    // Super+F2 hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "microphone-down"; }
    // Super+F3 hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "microphone-up"; }

    // XF86AudioRaiseVolume hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "volume-up"; }
    // XF86AudioLowerVolume hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "volume-down"; }
    // XF86AudioMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "ashell" "msg" "volume-toggle-mute"; }
    // XF86AudioMicMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "ashell" "msg" "microphone-toggle-mute"; }
    // Super+XF86AudioMute hotkey-overlay-title=null repeat=false allow-when-locked=true { spawn "ashell" "msg" "microphone-toggle-mute"; }
    // Super+XF86AudioRaiseVolume hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "microphone-up"; }
    // Super+XF86AudioLowerVolume hotkey-overlay-title=null allow-when-locked=true { spawn "ashell" "msg" "microphone-down"; }

    // player
    XF86AudioPlay repeat=false allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop repeat=false allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev repeat=false allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext repeat=false allow-when-locked=true { spawn-sh "playerctl next"; }

    // brightness
    // XF86MonBrightnessUp  cooldown-ms=100 allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    // XF86MonBrightnessDown cooldown-ms=100 allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // brightness ashell
    XF86MonBrightnessUp  cooldown-ms=100 allow-when-locked=true { spawn "ashell" "msg" "brightness-up"; }
    XF86MonBrightnessDown cooldown-ms=100 allow-when-locked=true { spawn "ashell" "msg" "brightness-down"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Shift+C repeat=false { close-window; }

    Mod+Left  hotkey-overlay-title=null { focus-column-left; }
    Mod+Down  hotkey-overlay-title=null { focus-window-down-or-column-left; }
    Mod+Up    hotkey-overlay-title=null { focus-window-up-or-column-right; }
    Mod+Right hotkey-overlay-title=null { focus-column-right; }
    Mod+H                               { focus-column-left; }
    Mod+N                               { focus-window-down-or-column-left; }
    Mod+E                               { focus-window-up-or-column-right; }
    Mod+I                               { focus-column-right; }

    Mod+T { focus-window-down-or-column-right; }
    Mod+S { focus-window-up-or-column-left; }
    Mod+R { focus-window-previous; }

    Mod+Shift+Left  hotkey-overlay-title=null { move-column-left; }
    Mod+Shift+Down  hotkey-overlay-title=null { move-window-down; }
    Mod+Shift+Up    hotkey-overlay-title=null { move-window-up; }
    Mod+Shift+Right hotkey-overlay-title=null { move-column-right; }
    Mod+Shift+H                               { move-column-left; }
    Mod+Shift+N                               { move-window-down; }
    Mod+Shift+E                               { move-window-up; }
    Mod+Shift+I                               { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+W             { focus-monitor-next; }
    Mod+Shift+W       { move-column-to-monitor-next; }
    Mod+Ctrl+W        { move-window-to-monitor-next; }
    Mod+Shift+Ctrl+W  { move-workspace-to-monitor-next; }

    Mod+Page_Down            hotkey-overlay-title=null { focus-workspace-down; }
    Mod+Page_Up              hotkey-overlay-title=null { focus-workspace-up; }
    Mod+L                                              { focus-workspace-down; }
    Mod+U                                              { focus-workspace-up; }
    Mod+Shift+Page_Down      hotkey-overlay-title=null { move-column-to-workspace-down; }
    Mod+Shift+Page_Up        hotkey-overlay-title=null { move-column-to-workspace-up; }
    Mod+Shift+L                                        { move-column-to-workspace-down; }
    Mod+Shift+U                                        { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down       hotkey-overlay-title=null { move-window-to-workspace-down; }
    Mod+Ctrl+Page_Up         hotkey-overlay-title=null { move-window-to-workspace-up; }
    Mod+Ctrl+L                                         { move-window-to-workspace-down; }
    Mod+Ctrl+U                                         { move-window-to-workspace-up; }
    Mod+Ctrl+Shift+Page_Down hotkey-overlay-title=null { move-workspace-down; }
    Mod+Ctrl+Shift+Page_Up   hotkey-overlay-title=null { move-workspace-up; }
    Mod+Ctrl+Shift+L                                   { move-workspace-down; }
    Mod+Ctrl+Shift+U                                   { move-workspace-up; }

    // You can bind mouse wheel scroll ticks using the following syntax.
    // These binds will change direction based on the natural-scroll setting.
    //
    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Mod+WheelScrollRight      { focus-column-right; }
    // Mod+WheelScrollLeft       { focus-column-left; }
    // Mod+Shfit+WheelScrollRight { move-column-right; }
    // Mod+Shfit+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    // Mod+Ctrl+WheelScrollDown      { focus-column-right; }
    // Mod+Ctrl+WheelScrollUp        { focus-column-left; }
    // Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    // Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Similarly, you can bind touchpad scroll "ticks".
    // Touchpad scrolling is continuous, so for these binds it is split into
    // discrete intervals.
    // These binds are also affected by touchpad's natural-scroll, so these
    // example binds are "inverted", since we have natural-scroll enabled for
    // touchpads by default.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // You can refer to workspaces by index. However, keep in mind that
    // niri is a dynamic workspace system, so these commands are kind of
    // "best effort". Trying to refer to a workspace index bigger than
    // the current workspace count will instead refer to the bottommost
    // (empty) workspace.
    //
    // For example, with 2 workspaces + 1 empty, indices 3, 4, 5 and so on
    // will all refer to the 3rd workspace.
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }
    Mod+0 repeat=false { focus-workspace 10; }
    Mod+Shift+1 repeat=false { move-column-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-column-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-column-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-column-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-column-to-workspace 5; }
    Mod+Shift+6 repeat=false { move-column-to-workspace 6; }
    Mod+Shift+7 repeat=false { move-column-to-workspace 7; }
    Mod+Shift+8 repeat=false { move-column-to-workspace 8; }
    Mod+Shift+9 repeat=false { move-column-to-workspace 9; }
    Mod+Shift+0 repeat=false { move-column-to-workspace 10; }
    Mod+Ctrl+1 repeat=false { move-window-to-workspace 1; }
    Mod+Ctrl+2 repeat=false { move-window-to-workspace 2; }
    Mod+Ctrl+3 repeat=false { move-window-to-workspace 3; }
    Mod+Ctrl+4 repeat=false { move-window-to-workspace 4; }
    Mod+Ctrl+5 repeat=false { move-window-to-workspace 5; }
    Mod+Ctrl+6 repeat=false { move-window-to-workspace 6; }
    Mod+Ctrl+7 repeat=false { move-window-to-workspace 7; }
    Mod+Ctrl+8 repeat=false { move-window-to-workspace 8; }
    Mod+Ctrl+9 repeat=false { move-window-to-workspace 9; }
    Mod+Ctrl+0 repeat=false { move-window-to-workspace 10; }

    // Switches focus between the current and the previous workspace.
    // Mod+Tab { focus-workspace-previous; }

    Mod+Shift+Comma  repeat=false { consume-or-expel-window-left; }
    Mod+Shift+Period repeat=false { consume-or-expel-window-right; }
    Mod+Comma        repeat=false { consume-window-into-column; }
    Mod+Period       repeat=false { expel-window-from-column; }

    Mod+Shift+T      repeat=false hotkey-overlay-title="Switch Column Width Preset" { switch-preset-column-width; }
    Mod+Ctrl+T       repeat=false hotkey-overlay-title="Switch Column Width Preset Reverse" { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+T repeat=false hotkey-overlay-title="Reset Column Width Preset" { expand-column-to-available-width; }

    Mod+Shift+S      repeat=false hotkey-overlay-title="Switch Window Height Preset" { switch-preset-window-height; }
    Mod+Ctrl+S       repeat=false hotkey-overlay-title="Switch Window Height Preset Reverse" { switch-preset-window-height-back; }
    Mod+Ctrl+Shift+S repeat=false hotkey-overlay-title="Reset Window Height Preset" { reset-window-height; }

    Mod+Ctrl+F  repeat=false hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+F repeat=false hotkey-overlay-title="Toggle Fullscreen" { fullscreen-window; }
    Mod+F       repeat=false hotkey-overlay-title="Toggle Maximize To Edge" { maximize-window-to-edges; }

    Mod+Ctrl+C repeat=false { center-visible-columns; }
    // Mod+C { center-column; }

    Mod+Minus hotkey-overlay-title="Set Window Width: -10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Set Window Width: +10%" { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus hotkey-overlay-title="Set Window Height: -10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Set Window Height: +10%" { set-window-height "+10%"; }

    Mod+Shift+A hotkey-overlay-title="Toggle Window Floating" { toggle-window-floating; }
    Mod+A hotkey-overlay-title="Switch Focus Between Floating And Tiling" { switch-focus-between-floating-and-tiling; }

    Mod+Shift+D hotkey-overlay-title="Toggle Tabbed Display" { toggle-column-tabbed-display; }

    // Actions to switch layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Mod+Shift+R      repeat=false hotkey-overlay-title="Screenshot"            { screenshot; }
    Mod+Ctrl+R       repeat=false hotkey-overlay-title="Screenshot Window" { screenshot-window; }
    Mod+Shift+Ctrl+R repeat=false hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }

    Mod+BracketRight            hotkey-overlay-title="Set Window To Dynamic Cast Target" { set-dynamic-cast-window; }
    Mod+Shift+BracketRight      hotkey-overlay-title="Set Monitor To Dynamic Cast Target" { set-dynamic-cast-monitor; }
    Mod+Shift+Ctrl+BracketRight hotkey-overlay-title="Clear Dynamic Cast Target" { clear-dynamic-cast-target; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+BackSlash repeat=false hotkey-overlay-title="Turn Off Monitors" { power-off-monitors; }
    Mod+Shift+BackSlash repeat=false hotkey-overlay-title="Lock the Screen: hyprlock" { spawn "hyprlock"; }
    Mod+Ctrl+Shift+BackSlash repeat=false hotkey-overlay-title="Trigger Idle" { spawn "killall" "-SIGUSR1" "swayidle"; }

    Mod+Shift+V repeat=false hotkey-overlay-title="Clipboard History" { spawn-sh "clipvault list | tofi | clipvault get | wl-copy"; }

    // exec or focus
    Mod+P repeat=false hotkey-overlay-title=null { spawn "niri-exec-or-focus" "Myazi" "footclient" "-a" "Myazi" "-T" "yazi" "-L" "yazi"; }
    Mod+C repeat=false hotkey-overlay-title=null { spawn "niri-exec-or-focus" "Mnvim" "footclient" "-a" "Mnvim" "-T" "neovim" "-L" "zellij" "a" "-c" "dev"; }
    Mod+V repeat=false hotkey-overlay-title=null { spawn "niri-exec-or-focus" "org.telegram.desktop" "Telegram"; }
    Mod+B repeat=false hotkey-overlay-title=null { spawn "niri-exec-or-focus" "zen" "zen-browser"; }

    // scratchpads
    Mod+Shift+Semicolon repeat=false hotkey-overlay-title="Toggle Scratchpad: Mbtop" { spawn "nscratch" "-a" "-m" "-id" "Mbtop" "-s" "footclient -a Mbtop -T btop -L btop -p 0"; }
    Mod+Shift+BracketLeft repeat=false hotkey-overlay-title="Toggle Scratchpad: ncmpcpp" { spawn "nscratch" "-a" "-m" "-id" "Mncmpcpp" "-s" "footclient -a Mncmpcpp -T ncmpcpp -L ncmpcpp"; }
    // Mod+Shift+Y repeat=false hotkey-overlay-title="Toggle Scratchpad: pavucontrol" { spawn "nscratch" "-a" "-m" "-id" "org.pulseaudio.pavucontrol" "-s" "pavucontrol -t 4"; }
    Mod+Shift+Y repeat=false hotkey-overlay-title="Toggle Scratchpad: " { spawn "nscratch" "-a" "-m" "-id" "Mmixer" "-s" "footclient -a Mmixer -T wiremix -L wiremix -v output"; }

    Mod+Grave repeat=false hotkey-overlay-title=null { spawn "killall" "-SIGUSR1" "waybar"; }
    // Mod+Grave repeat=false hotkey-overlay-title=null { spawn "ashell" "msg" "toggle-visibility"; }

    Mod+Shift+Q repeat=false hotkey-overlay-title="Shutdown Menu" { spawn "tofi-shutdown-menu"; }
    Mod+Shift+Ctrl+Q repeat=false hotkey-overlay-title="Quit" { quit; }

}

recent-windows {
    binds {
        Mod+Tab         { next-window     scope="output"; }
        Mod+Shift+Tab   { previous-window scope="output"; }
        Alt+Grave       { next-window     scope="workspace"; }
        Alt+Shift+Grave { previous-window scope="workspace"; }
        Alt+Tab         { next-window     scope="all"; }
        Alt+Shift+Tab   { previous-window scope="all"; }
    }
}
