{
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "l1": "1",
            "l2": "2",
            "l3": "3",
            "l4": "4",
            "l5": "5",
            "l6": "6",
            "l7": "7",
            "l8": "8",
            "l9": "9",
            "l10": "0",
            "l11": "-",
            "l12": "=",
            "r1": "1",
            "r2": "2",
            "r3": "3",
            "r4": "4",
            "r5": "5",
            "r6": "6",
            "r7": "7",
            "r8": "8",
            "r9": "9",
            "r10": "0",
            "r11": "-",
            "r12": "=",
            "scratch": "",
            "urgent": "",
            // "focused": "",
            "default": ""
        }
    },
    "niri/language": {
        "format": "{long}"
    },
    "niri/window": {
        "format": "  {title}",
        "max-length": 50
    }
}
