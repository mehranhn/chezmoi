#!/bin/sh
choices="1: Shutdown\n2: Reboot\n3: Sleep"

chosen=$(echo -e $choices | fuzzel -d --prompt-text "Power Menu: ")

case $chosen in
    *"Shutdown")
        systemctl poweroff
        ;;
    *"Reboot")
        systemctl reboot
        ;;
    *"Sleep")
        systemctl suspend
        ;;
esac
