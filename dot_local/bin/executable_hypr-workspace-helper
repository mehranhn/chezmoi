#!/bin/sh

ACTION="$1"
WORKSPACE_INDEX="$2"

if [ "$ACTION" != "focus" ] && [ "$ACTION" != "move" ]; then
    echo "First argument must be 'focus' or 'move'"
    exit 1
fi

if [ -z "$WORKSPACE_INDEX" ]; then
    echo "Second argument must be a number"
    exit 1
fi

MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .name')

if [ "$MONITOR" = "HDMI-A-1" ]; then
    WORKSPACE_INDEX=$((WORKSPACE_INDEX + 10))
fi

if [ "$ACTION" = "focus" ]; then
    hyprctl dispatch workspace "$WORKSPACE_INDEX"
else
    hyprctl dispatch movetoworkspacesilent "$WORKSPACE_INDEX"
fi
